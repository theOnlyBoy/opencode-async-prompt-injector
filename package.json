{
  "name": "opencode-async-prompt-injector",
  "version": "1.0.0",
	"description": "Slide a sticky note under your OpenCode agent's nose while it's busy thinking. Mid-task. No interruption.",
	"keywords": [
		"opencode",
		"plugin",
		"ai",
		"agent",
		"prompt",
		"inject",
		"async"
  ],
  "homepage": "https://github.com/theOnlyBoy/opencode-async-prompt-injector",
  "bugs": {
    "url": "https://github.com/theOnlyBoy/opencode-async-prompt-injector/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Nik S. <nikoladious@proton.me>",
    "url": "https://github.com/theOnlyBoy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theOnlyBoy/opencode-async-prompt-injector.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "npx oxlint --type-aware --type-check",
    "lint:fix": "npx oxlint --type-aware --type-check --fix",
    "format:style": "npx oxfmt ./src",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.18"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
		"typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22"
  }
}
